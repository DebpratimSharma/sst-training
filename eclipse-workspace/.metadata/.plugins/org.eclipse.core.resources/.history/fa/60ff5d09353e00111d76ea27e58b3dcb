package com.aot.oops;
import java.util.Scanner;
public class CurtainBox {
	public static int maxAquaCurtains(String curtains, int l) {
		int maxCount = 0;
		int currentCount = 0;
		
		for(int i = 0; i< curtains.length(); i++) {
			if(curtains.charAt(i)=='a')
				currentCount++;
			if((i+1)%l==0 || i==curtains.length()-1) {
				if(currentCount>maxCount)
					maxCount = currentCount;
			}
			currentCount = 0;
		}
		return maxCount;
	}

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.println("Enter the string for curtains: ");
		String curtains = sc.nextLine();
		System.out.println("Enter the length: ");
		int l = sc.nextInt();
		int result = maxAquaCurtains(curtains, l);
		System.out.println("Result is : "+ result);
	}

}
